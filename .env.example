# ============================================================================
# PLANTILLA DE CONFIGURACIÓN — Calidad del Aire SEMADET
#
# Copia este archivo como  .env  (sin extensión) y llénalo con tus valores.
# El .env NUNCA se sube al repositorio: contiene la llave privada de la
# cuenta de servicio, que da acceso a tus hojas sin contraseña.
#
#     cp .env.example .env        (Mac/Linux)
#     copy .env.example .env      (Windows)
#
# Requiere:  pip install python-dotenv
# ============================================================================


# ── CREDENCIALES DE GOOGLE ──────────────────────────────────────────────────
# Los valores salen del JSON que descargaste de Google Cloud Console.
# Ábrelo con el Bloc de notas y copia cada campo aquí.

GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=tu-proyecto-123456
GOOGLE_PRIVATE_KEY_ID=abc123def456...

# IMPORTANTE: la llave va entre comillas y en UNA SOLA LÍNEA, conservando
# los \n tal cual aparecen en el JSON. No los conviertas en saltos de línea
# reales ni borres el BEGIN/END: el código los traduce al leerlos.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n...\n-----END PRIVATE KEY-----\n"

GOOGLE_CLIENT_EMAIL=nombre-robot@tu-proyecto.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=123456789012345678901
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/nombre-robot%40tu-proyecto.iam.gserviceaccount.com
GOOGLE_UNIVERSE_DOMAIN=googleapis.com


# ── ALTERNATIVA: todo el JSON en una sola variable ──────────────────────────
# Útil en servicios donde se configuran secretos por panel (Cloud Run,
# Render, Railway, GitHub Actions). Si defines esta, las de arriba sobran.
# Debe ir en una sola línea, entre comillas simples.
#
# GOOGLE_CREDENCIALES_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'


# ── ALTERNATIVA: seguir usando el archivo JSON ──────────────────────────────
# Si prefieres el archivo en vez de variables, borra las GOOGLE_* de arriba
# y deja solo esta línea apuntando al archivo.
#
# GOOGLE_CREDENCIALES_ARCHIVO=credenciales.json


# ── HOJAS DE CÁLCULO ────────────────────────────────────────────────────────
# Recuerda compartir las cuatro con el correo de GOOGLE_CLIENT_EMAIL:
# la destino como Editor, las otras tres como Lector.

URL_DESTINO=https://docs.google.com/spreadsheets/d/xxxxxxxxxxxxxxxxxxxx/edit
URL_FUENTE_2025=https://docs.google.com/spreadsheets/d/xxxxxxxxxxxxxxxxxxxx/edit
URL_FUENTE_2026=https://docs.google.com/spreadsheets/d/xxxxxxxxxxxxxxxxxxxx/edit
URL_RESUMEN_MENSUAL=https://docs.google.com/spreadsheets/d/xxxxxxxxxxxxxxxxxxxx/edit
